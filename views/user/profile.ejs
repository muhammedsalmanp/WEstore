<script>
  document.addEventListener('DOMContentLoaded', function () {
    const zipcodeInput = document.getElementById('zipcode');
    const zipcodeError = document.getElementById('zipcodeError');
    const landmarkInput = document.getElementById('landmark');
    const landmarkSuggestions = document.getElementById('landmarkSuggestions');

    // Function to validate and fetch address details
    async function validateZipcode(zipcode) {
      try {
        const response = await fetch(`/api/getAddressDetails/${zipcode}`);
        const data = await response.json();

        if (data.success) {
          zipcodeError.textContent = '';
          zipcodeInput.style.borderColor = 'green';
          // Display location suggestions based on pin code
          // For simplicity, you can hardcode suggestions or integrate an API
          landmarkSuggestions.innerHTML = `<p>Suggested landmarks for ${data.city}, ${data.state}:</p>
            <ul>
              <li>Landmark 1</li>
              <li>Landmark 2</li>
              <li>Landmark 3</li>
            </ul>`;
        } else {
          zipcodeError.textContent = 'Invalid pin code.';
          zipcodeInput.style.borderColor = 'red';
          landmarkSuggestions.innerHTML = '';
        }
      } catch (error) {
        zipcodeError.textContent = 'Error verifying pin code.';
        zipcodeInput.style.borderColor = 'red';
        landmarkSuggestions.innerHTML = '';
      }
    }

    // Event listener for zip code input
    zipcodeInput.addEventListener('input', function () {
      const zipcode = zipcodeInput.value.trim();
      if (zipcode.length === 6) { // Assuming 6-digit pin code
        validateZipcode(zipcode);
      } else {
        zipcodeError.textContent = '';
        zipcodeInput.style.borderColor = '';
        landmarkSuggestions.innerHTML = '';
      }
    });
  });
</script>