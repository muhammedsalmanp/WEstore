                        <a href="/shop/productDetails/<%- product._id %>"><%= product.productName %></a>
                      </h2>
                      <div class="rating-result" title="90%">
                        <span><span></span></span>
                      </div>
                      <div class="product-price">
                        <span>₹<%= product.price %>.00</span>
                        <% if (product.onOffer) { %>
                        <span class="old-price">₹<%= product.oldPrice %>.00</span>
                        <% } %>
                      </div>
