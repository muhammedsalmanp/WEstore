<script>
  document.addEventListener('DOMContentLoaded', () => {
    const quickViewButtons = document.querySelectorAll('[data-bs-target="#quickViewModal"]');
    
    quickViewButtons.forEach(button => {
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        
        const productId = button.getAttribute('href').split('/').pop();
        const response = await fetch(`/shop/quickView/${productId}`);
        const modalContent = await response.text();
        
        document.querySelector('#quickViewModal .modal-content').innerHTML = modalContent;
        new bootstrap.Modal(document.getElementById('quickViewModal')).show();
      });
    });
  });
</script>
