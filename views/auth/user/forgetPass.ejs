<section>

  <div class="px-4 py-5 px-md-5 text-center text-lg-start" style="background-color: hsl(0, 0%, 96%)">
    <div class="col-lg-12">
      <h3 class="ltext-103 cl5 text-center mb-5">Forgot Password</h3>
    </div>
    <div class="container">
      <div class="row gx-lg-5 justify-content-center">
        <div class="col-lg-6 mb-5 mb-lg-0">
          <div class="card">
            <div class="row">
            </div>
            <div class="card-body py-5 px-md-5">
              <form action="/forgetPass" method="POST" id="forgetPassForm">
                <!-- Email input -->
                <div class="form-outline mb-4">
                  <label for="email" class="form-label text-left">Email</label>
                  <input name="email" type="email" class="form-control" id="email" placeholder="example@gmail.com" />
                  <small id="emailError" class="form-text text-danger d-none">Enter a valid email address</small>
                </div>
                <!-- Verify button -->
                <div class="flex-c-m">
                  <button type="submit" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04"
                    id="submitBtn">
                    Send OTP
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .form-control {
    border: 2px solid #ccc;
    transition: border-color 0.3s;
  }

  .form-control.invalid {
    border-color: red;
  }

  .form-control.valid {
    border-color: green;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("forgetPassForm");
    const emailInput = document.getElementById("email");
    const emailError = document.getElementById("emailError");

    form.addEventListener("submit", function (event) {
      // Prevent form submission if email is invalid
      if (!isValidEmail(emailInput.value)) {
        emailInput.classList.add("invalid");
        emailInput.classList.remove("valid");
        emailError.classList.remove("d-none");
        event.preventDefault();
      } else {
        emailInput.classList.add("valid");
        emailInput.classList.remove("invalid");
        emailError.classList.add("d-none");
      }
    });

    emailInput.addEventListener("input", function () {
      if (isValidEmail(this.value)) {
        this.classList.add("valid");
        this.classList.remove("invalid");
        emailError.classList.add("d-none");
      } else {
        this.classList.add("invalid");
        this.classList.remove("valid");
        emailError.classList.remove("d-none");
      }
    });

    function isValidEmail(email) {
      // Basic email validation regex
      const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return regex.test(email);
    }
  });
</script>