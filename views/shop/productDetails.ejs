                                                        <div class="form-group">
                                                            <textarea class="form-control" name="comment" id="comment" placeholder="Write your review here..."></textarea>
                                                        </div>
                                                        <div class="form-group">
                                                            <input type="file" name="image" id="image" accept="image/*">
                                                        </div>
                                                        <button type="submit" class="btn btn-primary">Submit Review</button>
                                                    </form>
                                                </div>
                                                <div id="reviews"></div>
                                            </div>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </main>


    
    <script>
    $(document).ready(function() {
        $('#zoom1, #zoom2, #zoom3, #zoom4').elevateZoom({
            zoomType: "lens",
            lensShape: "round",
            lensSize: 900,
            scrollZoom: true
        });
    });
</script>


