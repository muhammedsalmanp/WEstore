                                            <!-- <div class="product-rate d-inline-block mb-30">
                                            </div> -->
                                            <div class="review-section">
                                                <h2>Product Reviews</h2>
                                                <div class="review-form">
                                                    <div class="star-rating">
                                                        <span class="star" data-value="5">☆</span>
                                                        <span class="star" data-value="4">☆</span>
                                                        <span class="star" data-value="3">☆</span>
                                                        <span class="star" data-value="2">☆</span>
                                                        <span class="star" data-value="1">☆</span>
                                                    </div>
                                                    <form action="/submitReview" method="POST" enctype="multipart/form-data">
                                                        <input type="hidden" name="productId" value="<%= product._id %>">
                                                        <div class="form-group">
                                                            <input class="form-control" name="name" id="name" value="<%= user ? `${user.firstName || 'Your'} ${user.lastName || 'Name'}` : '' %>" placeholder="Your Name">
                                                        </div>
                                                        <div class="form-group">
                                                            <input class="form-control" name="email" id="email" value="<%= user ? user.email : '' %>" placeholder="Your Email">
