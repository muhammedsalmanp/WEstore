                                    <!-- Additional-info -->
                                    <div class="tab-pane fade" id="Additional-info">
                                        <table class="font-md">
                                            <tbody>
                                                <tr class="stand-up">
                                                    <th>Brand</th>
                                                    <td>
                                                        <p><%= product.category.name %></p>
                                                    </td>
                                                </tr>
                                                <tr class="folded-wo-wheels">
                                                    <th>Colour</th>
                                                    <td>
                                                        <p><%= product.Colour ? product.Colour : "Colour not available"  %></p>
                                                    </td>
                                                </tr>
                                                <tr class="folded-w-wheels">
                                                    <th>display size</th>
                                                    <td>
                                                        <p><%= product.displaySize ? product.displaySize +'Inches': "display size not available" %>  </p>
                                                    </td>
                                                </tr>
                                                <tr class="door-pass-through">
                                                    <th>Resolution</th>
                                                    <td>
                                                        <p><%= product.resolution ? product.resolution + ' Inches' : 'Resolution not available' %></p>
                                                    </td>
                                                </tr>
                                                <tr class="frame">
                                                    <th>Processor</th>
                                                    <td>
                                                        <p><%= product.Processor ? product.Processor : "Processor not available" %></p>
                                                    </td>
                                                </tr>
                                                <tr class="weight-wo-wheels">
                                                    <th>RAM Size</th>
                                                    <td>
                                                        <p><%= product.ramSize ? product.ramSize + ' GB' :'RAM Size not available' %></p>
                                                    </td>
                                                </tr>
                                                <tr class="weight-capacity">
                                                    <th>Hard Drive Size</th>
                                                    <td>
                                                        <p><%= product.hardDriveSize ? product.hardDriveSize +' GB': 'Hard Drive Size not available'%> </p>
                                                    </td>
                                                </tr>
                                                <tr class="width">
                                                    <th>Hard Disk Description</th>
                                                    <td>
                                                        <p><%= product.hardDiskDescription ? product.hardDiskDescription:"Hard Disk Description not available" %></p>
                                                    </td>
                                                </tr>
                                                <tr class="handle-height-ground-to-handle">
                                                    <th>Graphics Chipset Brand</th>
                                                    <td>
                                                        <p><%= product.graphicsChipsetBrand ? product.graphicsChipsetBrand : "Graphics Chipset Brand not available" %></p>
                                                    </td>
                                                </tr>
                                                <tr class="wheels">
                                                    <th>Operating System</th>
                                                    <td>
                                                        <p><%= product.operatingSystem ?product.operatingSystem : "Operating System not available" %></p>
                                                    </td>
                                                </tr>
                                                <tr class="seat-back-height">
                                                    <th>Number of USB 3.0 Ports</th>
                                                    <td>
                                                        <p><%= product.numberofUSB ? product.numberofUSB : "Number of USB not available"  %></p>
                                                    </td>
                                                </tr>
                                                <tr class="head-room-inside-canopy">
                                                    <th>Audio Details</th>
                                                    <td>
                                                        <p><%= product.audioDetails ? product.audioDetails:"Audio Details not available" %></p>
                                                    </td>
                                                </tr>
                                                <tr class="pa_color">
                                                    <th>Country of Origin</th>
                                                    <td>
                                                        <p><%= product.countryofOrigin  ?product.countryofOrigin : "Country of Origin not available"  %></p>
                                                    </td>
                                                </tr>
                                                <tr class="pa_size">
                                                    <th>Item Weight</th>
