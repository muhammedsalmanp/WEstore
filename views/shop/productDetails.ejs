

   <main class="main">
        <div class="page-header breadcrumb-wrap">
            <div class="container">
              <div class="breadcrumb">
                <a href="/" rel="nofollow">Home</a>
                <span></span>
                <a href="/allProducts" rel="nofollow">Shop</a>
                <span></span> 
                <a href="" rel="nofollow">Product Details</a>
              </div>
            </div>
          </div>
        <section class="mt-50 mb-50">
            <div class="container">         
                <div class="row">
                    <div class="col-lg-9">
                        <div class="product-detail accordion-detail">
                            <div class="container">
                                <div class="row mb-50">
                                    <div class="col-md-6 col-sm-12 col-xs-12">
                                        <div class="detail-gallery pr-3">
                                            <span class="zoom-icon"><i class="fi-rs-search"></i></span>
                                            <!-- MAIN SLIDES -->
                                            <div class="product-image-slider" style="background-color: white;">
                                              <% if (product.primaryImages && product.primaryImages.length > 0) { %>
                                                <% product.primaryImages.forEach((image, index) => { %>
                                                  <figure class="border-radius-10">
                                                    <img id="zoom<%= index + 1 %>" 
                                                        src="/uploads/products-images/crp/<%= image.name %>" 
                                                        alt="IMG-PRODUCT" 
                                                        data-zoom-image="/uploads/products-images/crp/<%= image.name %>"/>
                                                  </figure>
                                                <% }); %>
                                              <% } %>
                                              
                                              <% if (product.secondaryImages && product.secondaryImages.length > 0) { %>
                                                <% product.secondaryImages.forEach((image, index) => { %>
                                                  <figure class="border-radius-10">
                                                    <img id="zoom<%= index + 1 + product.primaryImages.length %>" 
                                                        src="/uploads/products-images/crp/<%= image.name %>" 
                                                        alt="IMG-PRODUCT" 
                                                        data-zoom-image="/uploads/products-images/crp/<%= image.name %>"/>
                                                  </figure>
                                                <% }); %>
                                              <% } %>
                                            </div>

                                            <!-- THUMBNAILS -->
                                            <div class="slider-nav-thumbnails pl-15 pr-15">
                                              <% if (product.primaryImages && product.primaryImages.length > 0) { %>
                                                <% product.primaryImages.forEach((image, index) => { %>
                                                  <div><img src="/uploads/products-images/crp/<%= image.name %>" alt="product image"></div>
                                                <% }); %>
                                              <% } %>

                                              <% if (product.secondaryImages && product.secondaryImages.length > 0) { %>
                                                <% product.secondaryImages.forEach((image, index) => { %>
                                                  <div><img src="/uploads/products-images/crp/<%= image.name %>" alt="product image"></div>
                                                <% }); %>
                                              <% } %>
                                            </div>

                                        </div>
                                        <!-- End Gallery -->
                                        <div class="social-icons single-share">
                                            <ul class="text-grey-5 d-inline-block">
                                                <li><strong class="mr-10">Share this:</strong></li>
                                                <li class="social-facebook"><a href="#"><img src="/frd/assets/imgs/theme/icons/icon-facebook.svg" alt=""></a></li>
                                                <li class="social-twitter"><a href="#"><img src="/frd/assets/imgs/theme/icons/icon-twitter.svg" alt=""></a></li>
                                                <li class="social-instagram"><a href="#"><img src="/frd/assets/imgs/theme/icons/icon-instagram.svg" alt=""></a></li>
                                                <li class="social-linkedin"><a href="#"><img src="/frd/assets/imgs/theme/icons/icon-pinterest.svg" alt=""></a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12 col-xs-12">
                                        <div class="detail-info pl-3">
                                            <h2 class="title-detail"><%= product.productName %></h2>
                                            <div class="product-detail-rating">
                                                <div class="pro-details-brand">
                                                    <span> Brands:<%= product.category.name %></a></span>
                                                </div>
                                                <div class="product-rate-cover text-end">
                                                    <div class="product-rate d-inline-block">
                                                        <div class="product-rating" style="width:90%"></div>
                                                    </div>
                                                    <span class="font-small ml-5 text-muted"> (25 reviews)</span>
                                                </div>
                                            </div>
                                            <div class="clearfix product-price-cover">
                                                <div class="product-price primary-color float-left">
                                                    <ins><span class="text-brand"><%= product.price %>.00</span></ins>
                                                    <% if (product.onOffer) { %>
                                                        <span class="old-price">₹<%= product.oldPrice %>.00</span>
                                                        <span class="save-price font-md color3 ml-15"><%- product.offerDiscountPersantage%>% Off
                                                        </span>
                                                        <% } %>
                                                   
                                                </div>
                                            </div>
                                            <div class="bt-1 border-color-1 mt-15 mb-15"></div>
                                            <div class="short-desc mb-30">
                                                <p><%= product.description %></p>
                                            </div>
                                            <div class="product_sort_info font-xs mb-30">
                                                <ul>
                                                    <li class="mb-10"><i class="fi-rs-crown mr-1"></i> 1 Year AL Jazeera Brand Warranty</li>
                                                    <li class="mb-10"><i class="fi-rs-refresh  mr-1"></i> 7 Day Return Policy</li>
                                                    <li><i class="fi-rs-credit-card  mr-1"></i> Cash on Delivery available</li>
                                                </ul>
                                            </div>
                                            <div class="bt-1 border-color-1 mt-30 mb-30"></div>
                                            <div class="detail-extralink "> 
                                                <div class="detail-extralink d-flex justify-content-center align-items-center">
                                                    <div class="detail-qty border radius mb-0 mr-1">
                                                        <a href="#" class="qty-down"><i class="fi-rs-angle-small-down"></i></a>
                                                        <span class="qty-val">1</span>
                                                        <a href="#" class="qty-up"><i class="fi-rs-angle-small-up"></i></a>
                                                    </div>
                                                    <div class="product-extra-link2 d-flex align-items-center">
                                                        <% if (product.stock > 0) { %>
                                                            <button type="button" class="button add-to-cart-btn" data-product-id="<%- product._id %>">Add to Cart</button>
                                                        <% } else { %>
                                                            <button type="button" class="button out-of-stock-btn"data-product-id="<%- product._id %>">Add to Cart</button>
                                                        <% } %>
                                                        <% if (user && user.wishlist) { %> 
                                                            <% let isInWishlist = user.wishlist.some(item => item.toString() === product._id.toString()); %>
                                                            <% if (isInWishlist) { %>
                                                                <a aria-label="Remove From Wishlist" class="action-btn hover-up wishlist-btn active" data-product-id="<%- product._id %>">
                                                                    <i class="fi-rs-heart-filled"></i>
                                                                </a>
                                                            <% } else { %>
                                                                <a aria-label="Add To Wishlist" class="action-btn hover-up wishlist-btn" data-product-id="<%- product._id %>">
                                                                    <i class="fi-rs-heart"></i>
                                                                </a>
                                                            <% } %>
                                                        <% } else { %>
                                                            <a aria-label="Add To Wishlist" class="action-btn hover-up wishlist-btn" data-product-id="<%- product._id %>">
                                                                <i class="fi-rs-heart"></i>
                                                            </a>
                                                        <% } %>
                                                    </div>
                                                </div>
                                                
                                                
                                                
                                            <ul class="product-meta font-xs color-grey mt-50">
                                                <li class="mb-5">SKU: <a href="#">FWM15VKT</a></li>
                                                <li class="mb-5">Tags: <a href="#" rel="tag">laptop</a>, <a href="#" rel="tag">gaming</a>, <a href="#" rel="tag">windows</a></li>
                                                <li>Availability:<span class="in-stock text-success ml-2">
                                                    <%if(product.stock === 0 || product.stock < 0  ){%>
                                                    <span class=" text text-danger"> Out Of Stock</span>
                                                <% }else{ %>
                                                    <%=product.stock %>
                                                <% } %></span></li>
                                            </ul>
                                        </div>
                                        <!-- Detail Info -->
                                    </div>
                                </div>
                            </div>
                            <!-- navcation to des, info, revi  -->
                            <div class="tab-style3">
                                <ul class="nav nav-tabs text-uppercase">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="Description-tab" data-bs-toggle="tab" href="#Description">Description</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="Additional-info-tab" data-bs-toggle="tab" href="#Additional-info">Additional info</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="Reviews-tab" data-bs-toggle="tab" href="#Reviews">Reviews</a>
                                    </li>
                                </ul>
                                <div class="tab-content shop_info_tab entry-main-content">
