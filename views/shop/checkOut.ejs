<script>
    document
    .getElementById("applyCouponBtn")
    .addEventListener("click", function () {
        fetch("/coupons/available")
            .then((response) => response.json())
            .then((coupons) => {
                let couponList = '<ul id="couponsList" class="list-group">';
                if (coupons.length > 0) {
                    coupons.forEach(function (coupon) {
                        couponList += `
                            <li class="list-group-item">
                                <strong>${coupon.code}</strong> - ${coupon.discountPercentage}% off, Min Purchase: ${coupon.minPurchaseAmount}
                                <a href="#" class="btn btn-primary btn-sm apply-coupon-btn" data-coupon-code="${coupon.code}">Apply</a>
                            </li>
                        `;
                    });
                } else {
                    couponList += '<li class="list-group-item">No available coupons</li>';
                }
                couponList += "</ul>";

                // Add the input field for manual coupon entry
                let couponInputHtml = `
                    <div class="input-group mb-3">
                        <input type="text" id="manualCouponCode" class="form-control" placeholder="Enter Coupon Code" aria-label="Coupon Code">
                        <button class="btn btn-primary apply-manual-coupon-btn" type="button">Apply</button>
                    </div>
                `;

                Swal.fire({
                    title: "Available Coupons",
                    html: couponInputHtml + couponList,
                    showCloseButton: true,
                    showCancelButton: false,
                    focusConfirm: false,
                    confirmButtonText: "Close",
                });

                // Handle click event for coupon application from the list
                document.querySelectorAll(".apply-coupon-btn").forEach((button) => {
                    button.addEventListener("click", function () {
                        let couponCode = this.getAttribute("data-coupon-code");
                        document.getElementById("coupon-code").value = couponCode;
                        Swal.close();
                    });
                });

                // Handle click event for manual coupon entry
                document.querySelector(".apply-manual-coupon-btn").addEventListener("click", function () {
                    let manualCouponCode = document.getElementById("manualCouponCode").value;
                    if (manualCouponCode) {
                        document.getElementById("coupon-code").value = manualCouponCode;
                        Swal.close();
                    } else {
                        Swal.fire("Error", "Please enter a coupon code.", "error");
                    }
                });
            })
            .catch((error) => {
                console.error("Error fetching coupons:", error);
                Swal.fire("Error", "Could not load coupons. Please try again later.", "error");
            });
    });

</script>

<script>
    document.querySelector("#payment-form").addEventListener("submit", async function (e) {
    e.preventDefault();

    const selectedPaymentMethod = document.querySelector('input[name="paymentoptions"]:checked')?.value;
    const totalPrice = parseFloat("<%= (cart && cart.offerAppliedTotalAmount) ? cart.offerAppliedTotalAmount : 0 %>");
    const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked');

    if (!selectedAddress) {
        Swal.fire({
            title: "Error",
            text: "Please select an address.",
            icon: "error",
        });
        return;
    }

    const addressId = selectedAddress.value;

    if (!selectedPaymentMethod) {
        Swal.fire({
            title: "Error",
            text: "Please select a payment method.",
            icon: "error",
        });
        return;
    }

    if (selectedPaymentMethod === "COD" && totalPrice > 1000) {
        Swal.fire({
            title: "Error",
            text: "Cash On Delivery is not available for orders above ₹1000.",
            icon: "error",
        });
        return;
    }

    try {
        const response = await fetch('/checkOut/placeOrder', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                paymentoptions: selectedPaymentMethod,
                address: addressId
            })
        });
        const data = await response.json();

        if (!data.success) {
            throw new Error(data.message || 'There was an issue with your order. Please try again.');
        }

        if (selectedPaymentMethod === "Razor Pay") {
            handleRazorPay(totalPrice, data.orderId);
        } else if (selectedPaymentMethod === "Wallet") {
            await handleWalletPayment(totalPrice, data.orderId);
        } else if (selectedPaymentMethod === "COD") {
            showPurchaseSuccessDialog(data.orderId);
        }
    } catch (error) {
        Swal.fire({
            title: 'Error',
            text: error.message || 'An unexpected error occurred. Please try again later.',
            icon: 'error'
        });
    }
});

async function handleWalletPayment(totalPrice, orderId) {
    try {
        const walletResponse = await fetch('/user/check-wallet-balance', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                amount: totalPrice,
                orderId: orderId
            })
        });
        const walletData = await walletResponse.json();

        if (walletData.success) {
            showPurchaseSuccessDialog(orderId);
        } else {
            const shortfall = walletData.shortfall;
            Swal.fire({
                title: 'Insufficient Wallet Balance',
                text: `You need to add ₹${shortfall} to complete this purchase.`,
                icon: 'error',
                showCancelButton: true,
                confirmButtonText: 'Add Money',
                cancelButtonText: 'Cancel'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    await handleAddMoney(shortfall, orderId);
                }
            });
        }
    } catch (error) {
        Swal.fire({
            title: 'Error',
            text: 'An unexpected error occurred. Please try again later.',
            icon: 'error'
        });
    }
}

async function handleAddMoney(shortfall, orderId) {
    try {
        // Show input dialog to enter the amount
        const { value: addMoneyAmount } = await Swal.fire({
            title: 'Add Money to Wallet',
            html: `<input id="addMoneyAmount" type="number" class="swal2-input" placeholder="Enter amount" min="${shortfall}" value="${shortfall}">`,
            confirmButtonText: 'Add Money',
            showCancelButton: true,
            cancelButtonText: 'Cancel',
            preConfirm: () => {
                const amount = parseFloat(document.querySelector("#addMoneyAmount").value);

                // Start payment process
                return fetch('/wallet/createwalletpayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ amount: amount })
                })
                .then(response => response.json())
                .then(data => {
                    if (!data.success) {
                        throw new Error(data.message || 'Payment initiation failed');
                    }

                    // Configure Razorpay payment options
                    var options = {
                        key: data.key,
                        amount: data.amount, // in paise
                        currency: "INR",
                        name: "Add Balance",
                        description: "Adding funds to wallet",
                        order_id: data.orderId,
                        handler: function (response) {
                            fetch('/wallet/verifypayment', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    paymentId: response.razorpay_payment_id,
                                    orderId: data.orderId,
                                    amount: amount
                                })
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire('Payment Successful', 'Your wallet has been credited.', 'success')
                                    .then(() => {
                                        window.location.reload();
                                    });
                                } else {
                                    Swal.fire('Payment Failed', 'Verification failed. Please contact support.', 'error');
                                }
                            })
                            .catch(() => {
                                Swal.fire('Payment Failed', 'An error occurred during verification.', 'error');
                            });
                        },
                        modal: {
                            ondismiss: function () {
                                Swal.fire('Payment Failed', 'Payment was cancelled by the user.', 'error');
                            }
                        },
                        theme: {
                            color: "#3399cc"
                        }
                    };
                    var rzp = new Razorpay(options);
                    rzp.open();
                })
                .catch(error => {
                    Swal.fire('Error', error.message, 'error');
                });
            }
        });
    } catch (error) {
        Swal.fire({
            title: 'Error',
            text: 'An unexpected error occurred. Please try again later.',
            icon: 'error'
        });
    }
}

async function checkWalletBalanceAndProceed(totalPrice, orderId) {
    try {
        const walletResponse = await fetch('/user/check-wallet-balance', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                amount: totalPrice,
                orderId: orderId
            })
        });
        const walletData = await walletResponse.json();

        if (walletData.success) {
            showPurchaseSuccessDialog(orderId);
        } else {
            showPaymentFailedDialog(orderId);
        }
    } catch (error) {
        Swal.fire({
            title: 'Error',
            text: 'An unexpected error occurred. Please try again later.',
            icon: 'error'
        });
    }
}

function handleRazorPay(totalPrice, orderId) {
    const amountUSD = totalPrice;

    var options = {
        key: "<%= process.env.RAZOR_PAY_KEY_ID %>",
        amount: amountUSD * 100,
        currency: "INR",
        name: "Order Payment",
        description: "Payment for order",
        handler: function (response) {
            fetch("/user/verify-orderpayment", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    paymentId: response.razorpay_payment_id,
                    orderId: orderId
                }),
            })
            .then(response => response.json())
            .then(verifyData => {
                if (verifyData.success) {
                    if (verifyData.orderStatus === 'failed') {
                        showPaymentFailedDialog(orderId);
                    } else {
                        showPurchaseSuccessDialog(orderId);
                    }
                } else {
                    showPaymentFailedDialog(orderId);
                }
            })
            .catch(() => {
                showPaymentFailedDialog(orderId);
            });
        },
        theme: {
            color: "#3399cc",
        },
        modal: {
            ondismiss: function () {
                Swal.fire({
                    title: 'Payment Failed',
                    text: 'It seems like the payment was not completed. Please try again.',
                    icon: 'error',
                    confirmButtonText: 'Try Again'
                }).then(() => {
                    window.location.href = `/order/details/${orderId}`;
                });
            }
        }
    };

    var rzp1 = new Razorpay(options);
    rzp1.open();
}

function showPurchaseSuccessDialog(orderId) {
    Swal.fire({
        title: 'Purchase Successful',
        html: `Your order has been placed successfully!<br>Your order ID is ${orderId}`,
        icon: 'success',
        showCancelButton: true,
        confirmButtonText: 'Continue Shopping',
        cancelButtonText: 'Show Order Details'
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '/allProducts';
        } else {
            window.location.href = `/order/details/${orderId}`;
        }
    });
}

function showPaymentFailedDialog(orderId) {
    Swal.fire({
        title: 'Payment Failed',
        text: 'Unfortunately, your payment could not be processed. Please try again later or contact support.',
        icon: 'error',
        confirmButtonText: 'Retry Payment'
    }).then(() => {
        window.location.href = `/order/details/${orderId}`;
    });
}

</script>


