<script>
    document.addEventListener('DOMContentLoaded', function () {

        function onlyOneCheckbox(checkbox) {
            const addressId = checkbox.value;
            if (!addressId) return;

            // Make a request to update the cart and fetch new shipping charges
            fetch(`/getShippingCharges?addressId=${addressId}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                },
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Update shipping charges
                        const shippingChargeElement = document.querySelector('.shipping-charge');
                        if (shippingChargeElement) {
                            shippingChargeElement.innerHTML = `<em>${data.newDeliveryCharge}</em>`;
                        }

                        // Update total amount
                        const totalAmountElement = document.querySelector('#totalAmount');
                        if (totalAmountElement) {
                            totalAmountElement.innerHTML = `₹${data.newTotal.toFixed(2)}`;
                        }
                    } else {
                        console.error('Failed to update shipping charges and total');
                    }
                })
                .catch(error => console.error('Error:', error));
        }

        // Attach the function to all checkboxes
        document.querySelectorAll('.custom-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                onlyOneCheckbox(this);
            });
        });
    });
</script>



