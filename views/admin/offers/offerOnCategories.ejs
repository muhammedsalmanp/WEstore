<section class="content-main">
    <ol class="breadcrumb">
        <% breadcrumbs.forEach(function(crumb, index) { %>
            <% if (index === breadcrumbs.length - 1) { %>
                <li class="breadcrumb-item active"><%= crumb.name %></li>
            <% } else { %>
                <li class="breadcrumb-item"><a href="<%= crumb.url %>"><%= crumb.name %></a></li>
            <% } %>
        <% }); %>
    </ol>
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Categories</h2>
        </div>
        <div>
            <!-- <a href="/admin/offer/brands" class="btn btn-primary btn-sm rounded">Brand offer</a> -->
            <a href="/admin/offer/product" class="btn btn-primary btn-sm rounded">Product Offer </a>
         
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Discount (%)</th>
                            <th>Offer Status</th>
                            <th>Offer Type</th>
                            <th>Activate/Deactivate</th>
                            <th>Actions</th>  
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof categories !== "undefined" && categories.length > 0) { %>
                            <% categories.forEach((category, index) => { %>
                                <tr>
                                    <td class="align-middle"><%= (current - 1) * perPage + index + 1 %></td>
                                    <td class="align-middle"><b><%- category.name %></b></td>
                                    <td class="align-middle"><%= category.offerDiscountPersantage %></td>
                                    <td class="align-middle">
                                        <% if (category.onOffer) { %>
                                        <span class="badge bg-success">Active</span>
                                        <% } else { %>
                                        <span class="badge bg-danger">Not Active</span>
                                        <% } %>
                                    </td>
                                    <td><%=category && category.offerType ? category.offerType : "not in offer"   %></td>
                                    <td class="align-middle">
                                        <% if (!category.onOffer) { %>
                                        <button onclick="toggleCategoryOffer('<%- category._id %>', '<%- category.name %>', 'true')" class="btn btn-success btn-sm">Activate</button>
                                        <% } else { %>
                                        <button onclick="toggleCategoryOffer('<%- category._id %>', '<%- category.name %>', 'false')" class="btn btn-danger btn-sm">Deactivate</button>
                                        <% } %>
                                    </td>                                    
                                    <td class="align-middle">
                                        <button 
                                            type="button"
                                            data-bs-toggle="modal"
                                            data-category-id="<%- category._id %>" 
                                            data-category-name="<%- category.name %>"
                                            data-category-discount="<%= category.offerDiscountPersantage %>"
                                            data-category-offer-type="<%= category.offerType %>"
                                            data-category-description="<%= category.description %>"
                                            data-bs-target="#offerModal"
                                            class="btn btn-primary btn-sm">+ Add / Edit</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                    
                </table>
            </div>
        </div>
    </div>
    <% if (categories.length > 0 && (nextPage || current == pages)) { %>
        <nav aria-label="Dashboard pagination">
            <ul class="pagination justify-content-center mt-5">
                <% if (current == 1) { %>
                    <li class="page-item disabled"><a href="#" class="page-link">First</a></li>
                <% } else { %>
                    <li class="page-item"><a href="/admin/offer/Category/?page=1" class="page-link">First</a></li>
                <% } %>
                <% var i = (Number(current) > 5 ? Number(current) - 4 : 1) %>
                <% if (i !== 1) { %>
                    <li class="page-item disabled"><a href="#" class="page-link">...</a></li>
                <% } %>
                <% for (; i <= (Number(current) + 4) && i <= pages; i++) { %>
                    <% if (i == current) { %>
                        <li class="page-item disabled"><a href="#" class="page-link"><%= i %></a></li>
                    <% } else { %>
                        <li class="page-item"><a href="/admin/offer/Category?page=<%= i %>" class="page-link"><%= i %></a></li>
                    <% } %>
                <% if (i == Number(current) + 4 && i < pages) { %>
                    <li class="page-item disabled"><a href="#" class="page-link">...</a></li>
                <% } %>
                <% } %>
                <% if (current == pages) { %>
                    <li class="page-item disabled"><a href="#" class="page-link">Last</a></li>
                <% } else { %>
                    <li class="page-item"><a href="/admin/offer/Category/?page=<%= pages %>" class="page-link">Last</a></li>
                <% } %>
            </ul>
        </nav>
    <% } %>
</section>

<!-- Modal -->
<div class="modal fade" id="offerModal" tabindex="-1" aria-labelledby="offerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="offerModalLabel">Add / Edit Offer</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="offerForm" action="/admin/offer/Category" method="post">
            <input type="hidden" id="categoryId" name="categoryId">
            
            <div class="mb-3">
              <label for="categoryName" class="form-label">Category Name</label>
              <input type="text" class="form-control" id="categoryName" name="categoryName" readonly>
            </div>
            
            <div class="mb-3">
              <label for="offerDiscount" class="form-label">Discount (%)</label>
              <input type="number" class="form-control" id="offerDiscount" name="offerDiscount" min="0" max="100">
            </div>
  
            <!-- Sale Type Dropdown -->
            <div class="mb-3">
              <label for="offerType" class="form-label">Offer Type</label>
              <select class="form-control" id="offerType" name="offerType">
                <option value="General">General</option>
                <option value="Summer">Summer</option>
                <option value="Winter">Winter</option>
                <option value="Holiday">Holiday</option>
                <option value="Clearance">Clearance</option>
                <option value="Black Friday">Black Friday</option>
              </select>
            </div>
            
            <!-- Description -->
            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="3"></textarea>
            </div>
  
            <button type="submit" class="btn btn-primary">Save</button>
          </form>
        </div>
      </div>
    </div>
</div>
  
<script>
    document.addEventListener('DOMContentLoaded', function() {
      var offerModal = document.getElementById('offerModal');
      offerModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var categoryId = button.getAttribute('data-category-id');
        var categoryName = button.getAttribute('data-category-name');
        var categoryDiscount = button.getAttribute('data-category-discount');
        var categoryOfferType = button.getAttribute('data-category-offer-type');
        var categoryDescription = button.getAttribute('data-category-description');
  
        var modalTitle = offerModal.querySelector('.modal-title');
        var categoryIdInput = offerModal.querySelector('#categoryId');
        var categoryNameInput = offerModal.querySelector('#categoryName');
        var offerDiscountInput = offerModal.querySelector('#offerDiscount');
        var offerTypeInput = offerModal.querySelector('#offerType');
        var descriptionInput = offerModal.querySelector('#description');
  
        modalTitle.textContent = categoryName ? `Edit Offer for ${categoryName}` : 'Add New Offer';
        categoryIdInput.value = categoryId;
        categoryNameInput.value = categoryName;
        offerDiscountInput.value = categoryDiscount || '';
        offerTypeInput.value = categoryOfferType || 'General';
        descriptionInput.value = categoryDescription || '';
      });
    });
</script>
  
  
<script>
    function toggleCategoryOffer(categoryId, categoryName, status) {
        const action = status === "true" ? "activate" : "deactivate";
  
        Swal.fire({
            title: `Are you sure you want to ${action} the offer for this category?`,
            text: `Category: ${categoryName}`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, proceed',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/admin/offer/category/status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ categoryId, status })
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: result.message || 'Operation successful',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload(); // Reload the page to reflect changes
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: result.message || 'Failed to update status',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while updating the status',
                        timer: 2000,
                        showConfirmButton: false
                    });
                });
            }
        });
    }
  </script>
