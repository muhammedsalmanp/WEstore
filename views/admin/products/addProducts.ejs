                            <div class="col-lg-4">
                                <div class="mb-4">
                                    <label class="form-label">Add Stock</label>
                                    <input placeholder="1" name="productStock" type="number" class="form-control"
                                        min="1" oninput="checkInput(this)">
                                    <div id="productStock_error" class="error-message"
                                        style="color: red; display: none;">Stock must be at least 1.</div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-4">
                                    <label class="form-label">Price</label>
                                    <input placeholder="₹" type="number" class="form-control" name="price" min="0"
                                        oninput="checkInput(this)">
                                    <div id="price_error" class="error-message" style="color: red; display: none;">Price
                                        cannot be negative.</div>
                                </div>
                            </div>
