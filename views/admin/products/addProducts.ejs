            productNameError.style.display = 'block';
            isValid = false;
        } else {
            productNameError.style.display = 'none';
        }

        // Check Stock
        const productStock = document.querySelector('input[name="productStock"]');
        const productStockError = document.getElementById('productStock_error');
        if (productStock.value.trim() === '' || parseInt(productStock.value) < 1) {
            productStockError.style.display = 'block';
