        }

        // Check Country of Origin
        const countryofOrigin = document.querySelector('input[name="countryofOrigin"]');
        const countryofOriginError = document.getElementById('countryofOrigin_error');
        if (countryofOrigin.value.trim() === '') {
            countryofOriginError.style.display = 'block';
            isValid = false;
        } else {
            countryofOriginError.style.display = 'none';
        }

        // Check Item Weight
        const itemWeight = document.querySelector('input[name="itemWeight"]');
        const itemWeightError = document.getElementById('itemWeight_error');
        if (itemWeight.value.trim() === '') {
            itemWeightError.style.display = 'block';
            isValid = false;
        } else {
            itemWeightError.style.display = 'none';
        }

        // Check Description
        const description = document.querySelector('input[name="productDespt"]');
        const descriptionError = document.getElementById('description_error');
        if (description.value.trim() === '') {
            descriptionError.style.display = 'block';
            isValid = false;
        } else {
            descriptionError.style.display = 'none';
        }

        // Check Primary Image
        const primaryImage = document.getElementById('image1');
        const primaryImageError = document.getElementById('image1-error');
        if (primaryImage.files.length === 0) {
            primaryImageError.style.display = 'block';
            isValid = false;
        } else {
            primaryImageError.style.display = 'none';
        }

        return isValid;
    }

